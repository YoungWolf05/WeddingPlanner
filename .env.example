# Corporate LiteLLM endpoint
LITELLM_BASE_URL=replace_url_here

# Your LiteLLM API key (Bearer token). Required by LiteLLM.
LITELLM_API_KEY=sk-your-key-here

# Default model to use. One of:
#   claude-opus-4-8 | claude-sonnet-4-6
LITELLM_MODEL=claude-sonnet-4-6

# Optional embedding alias for the capability probe (npm run test:capabilities),
# the embedding compatibility probe (npm run test:embedding), and the retrieval
# evaluation (npm run eval:retrieval, which embeds the corpus + queries).
# Embeddings are a SEPARATE contract from chat aliases. If unset, the probes
# record embeddings as Unverified / "N/A — no embedding alias configured" instead
# of failing; npm run eval:retrieval REQUIRES it (there is no default embedding
# alias) and fails loudly (redacted) when it is unset.
# LITELLM_EMBED_MODEL=your-embedding-alias-here

# Optional EXPECTED embedding vector dimension (Phase 7 / 7d). This is the SINGLE
# source of truth for the dimension the knowledge store is built with AND the
# dimension the embedding alias must produce; the offline compatibility check and
# the live `npm run test:embedding` probe both read it. Optional; defaults to 768
# (matches the verified gemini-embedding-001 alias, docs/capabilities/2026-07-28.md).
# Must be a positive integer — a present-but-invalid value fails loud at startup.
# LITELLM_EMBED_DIM=768

# --- Durable conversation state (Phase 5 / 5a) ------------------------------
# Filesystem path to the local SQLite checkpoint database that persists
# conversation history across process restarts. Optional; defaults to
# ./data/checkpoints.sqlite (relative to the working directory). The parent
# directory is created on first use. This is LOCAL persistence only — it is NOT
# under the LITELLM_* namespace and configures no provider. The db file is
# gitignored; never commit it.
#
# LOCAL-RUN HYGIENE: the default path writes ./data INSIDE the repo (gitignored,
# but a stray ./data trips offline repo-cleanliness guards). For local `npm run
# serve`, point this OUTSIDE the repo (e.g. a temp dir). The offline suite never
# creates ./data.
# CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# --- Durable knowledge base (Phase 7 / 7a) ----------------------------------
# Filesystem path to the local SQLite KNOWLEDGE-BASE database (documents/chunks
# + the sqlite-vec vector table). This is a SEPARATE file and a SEPARATE
# connection from the conversation checkpoint DB above — the two never share a
# handle. Like CHECKPOINT_DB_PATH this is LOCAL persistence only — NOT under the
# LITELLM_* namespace and configures no provider. Optional; defaults to
# ./data/knowledge.sqlite (relative to the working directory). The parent
# directory is created on first use. The db file is gitignored (data/); never
# commit it. Same LOCAL-RUN HYGIENE applies: point it OUTSIDE the repo for local
# runs to avoid a stray ./data. The offline suite always uses temp paths, and
# `npm run eval:retrieval` builds its OWN ephemeral store in a temp dir OUTSIDE
# the repo (it does NOT read this variable), so it never creates ./data.
# KNOWLEDGE_DB_PATH=./data/knowledge.sqlite

# --- Authenticated HTTP service (Phase 5 / 5c) ------------------------------
# The service (npm run serve) exposes thread CRUD + streaming chat over SSE and
# authenticates EVERY request via a bearer token mapped to a user id.
#
# TCP port to listen on (127.0.0.1). Optional; defaults to 3000.
# SERVICE_PORT=3000
#
# Bearer-token -> userId map. REQUIRED to run the service (with no tokens the
# service rejects every request). The resolved userId becomes the OWNER of that
# caller's threads; thread ownership is enforced from this identity, never from
# any client-supplied owner/user id. Tokens are SECRETS — the values below are
# OBVIOUSLY FAKE placeholders; generate real, high-entropy tokens for real use
# and never commit them (.env is gitignored).
#
# Two accepted formats:
#   1. JSON object mapping token -> userId:
#      AUTH_TOKENS={"fake-token-alice-REPLACE-ME":"user-alice","fake-token-bob-REPLACE-ME":"user-bob"}
#   2. Comma-separated token:userId pairs:
#      AUTH_TOKENS=fake-token-alice-REPLACE-ME:user-alice,fake-token-bob-REPLACE-ME:user-bob
# AUTH_TOKENS=fake-token-alice-REPLACE-ME:user-alice,fake-token-bob-REPLACE-ME:user-bob

# --- HTTP service hardening timeouts (Phase 5 / 5d) -------------------------
# All milliseconds, all optional; the service falls back to the defaults shown.
# These mitigate slow-client/slowloris and idle SSE connections; offline tests
# inject tiny values directly, so these env vars are only for the live service.
#
# Max time to receive request headers (http.Server.headersTimeout). Default 10000.
# SERVICE_HEADERS_TIMEOUT_MS=10000
#
# Max time to receive the ENTIRE request incl. body (http.Server.requestTimeout).
# Also bounds the drain of an oversized (413'd) upload. Default 30000.
# SERVICE_REQUEST_TIMEOUT_MS=30000
#
# Max idle time on a chat SSE stream (no token emitted) before the turn is
# aborted and a redacted error event ends the stream. Reset on each token.
# Default 60000.
# SERVICE_SSE_IDLE_TIMEOUT_MS=60000

# --- Local tracing (Phase 4 / 4d) -------------------------------------------
# Local, self-contained tracing of each app LLM call (invoke + stream). OFF by
# default. Secret/PII redaction is ALWAYS ON and cannot be disabled. Traces are
# written LOCALLY to logs/ (gitignored) — no network, no external SaaS, no keys.
#
# Enable tracing (OFF by default). LITELLM_TRACE takes precedence over the TRACE
# alias: if LITELLM_TRACE is set to any non-empty value it is authoritative
# (LITELLM_TRACE=0 disables even if TRACE=1); only when LITELLM_TRACE is unset
# does TRACE apply. Accepted ON values: 1, true, yes, on (case-insensitive).
# LITELLM_TRACE=1
# TRACE=1

# Trace sink (default: file → logs/trace.jsonl). Set to "console" to write JSONL
# trace lines to stderr instead.
# LITELLM_TRACE_SINK=console

# Content capture opt-in. OFF by default: traces are METADATA ONLY (timestamp,
# model, operation, latency, usage, outcome, streaming flag, redacted error
# reason). When enabled, prompt/response content is captured but STILL passes
# through secret/PII redaction. Only meaningful when tracing is enabled.
# LITELLM_TRACE_CONTENT=1
