{
  "name": "wedding-planner-chatbot",
  "version": "0.1.0",
  "description": "A wedding planner chatbot built with LangChain + TypeScript, powered by a corporate LiteLLM endpoint.",
  "type": "module",
  "scripts": {
    "test:connection": "tsx src/test-connection.ts",
    "test:capabilities": "tsx src/probe-capabilities.ts",
    "test:contracts": "tsx src/probe-contracts.ts",
    "test:embedding": "tsx src/probe-embedding.ts",
    "eval": "tsx src/run-eval.ts",
    "chain": "tsx src/run-chain.ts",
    "memory": "tsx src/run-memory.ts",
    "chat": "tsx src/cli.ts",
    "serve": "tsx src/run-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vitest.json"
  },
  "keywords": [
    "langchain",
    "chatbot",
    "wedding-planner",
    "litellm"
  ],
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.3",
    "dotenv": "^17.4.2",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
