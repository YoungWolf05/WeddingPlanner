# Dependencies
node_modules/

# Build output
dist/

# Environment / secrets
.env
.env.local

# Logs
*.log
npm-debug.log*

# Local tracing output (Phase 4 / 4d). Trace events are written locally as
# newline-delimited JSON with secrets/PII redacted; never commit them.
logs/

# Durable conversation state (Phase 5 / 5a). The local SQLite checkpoint
# database (default ./data/checkpoints.sqlite; overridable via CHECKPOINT_DB_PATH)
# holds conversation history and must never be committed. Ignore the whole data/
# directory plus any stray SQLite files (incl. WAL/SHM sidecars).
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# OS
.DS_Store
Thumbs.db
