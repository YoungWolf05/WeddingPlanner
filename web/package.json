{
  "name": "wedding-planner-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 9 (9c) React + Vite browser SPA over the stable v2 SSE contract. A SEPARATE npm project, fully isolated from the backend build/test.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle": "node scripts/check-bundle-no-secrets.mjs",
    "build:check": "vite build && node scripts/check-bundle-no-secrets.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  }
}
